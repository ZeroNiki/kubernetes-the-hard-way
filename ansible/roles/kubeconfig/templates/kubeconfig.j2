{% set pki = kubeconfig_pki.results | items2dict(key_name='item', value_name='content') %}
apiVersion: v1
kind: Config
clusters:
  - name: {{ cluster_name }}
    cluster:
      certificate-authority-data: {{ pki['ca.crt'] }}
      server: {{ kc.server }}
users:
  - name: {{ kc.user }}
    user:
      client-certificate-data: {{ pki[kc.name ~ '.crt'] }}
      client-key-data: {{ pki[kc.name ~ '.key'] }}
contexts:
  - name: default
    context:
      cluster: {{ cluster_name }}
      user: {{ kc.user }}
current-context: default
